  (text "MeshGW Pi HAT - E22-900M30S carrier (rev A DRAFT, 2026-08-10)" (at 20.32 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "368b2f1a-60d3-44d0-bdd2-3c9b12a87fb3"))
  (text "DO NOT ORDER: E22 land pattern is datasheet-derived and has NOT been" (at 20.32 21.59 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "27767ccc-3275-42ba-ab3e-ff25aefeadcb"))
  (text "checked against a physical part; HAT mechanical geometry unverified." (at 20.32 26.67 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "aa2ca0d2-75ce-4d52-a160-91dd04511433"))
  (text "POWER: E22 VCC = +5V (Pi header pins 2/4), NOT 3V3." (at 20.32 199.39 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "8a75f926-2439-40ff-b301-da113e880c73"))
  (text "  Datasheet: 2.5-5.5V range but '>=5.0V ensures output power'," (at 20.32 205.74 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "2cd65135-c82d-468c-8857-25830dffb9ff"))
  (text "  650 mA instantaneous on a TX burst. The Pi 3V3 regulator must" (at 20.32 210.82 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "d1128d6b-1bc7-4435-8690-597c5184b45e"))
  (text "  not carry that. Logic level is 3.3V so SPI wires straight to" (at 20.32 217.17 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "ce45c73c-2031-468d-8220-d1511e9b2fd8"))
  (text "  the Pi with no level shifting." (at 20.32 222.25 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "9037b056-8fd7-43eb-a0b2-c6b3885c6791"))
  (text "RF: pad 21 (ANT stamp hole) is NO-CONNECT by design. The antenna" (at 20.32 233.68 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "5605b305-e00a-49f8-90b3-e805023cfc7e"))
  (text "  leaves through the module's own IPEX connector via an IPEX->SMA" (at 20.32 238.76 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "e35f2104-5907-46c6-bab9-24f38e1d3dcf"))
  (text "  bulkhead pigtail. Nothing on this 2-layer board is impedance-" (at 20.32 245.11 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "ba7e900c-de99-4170-8048-a265625efd56"))
  (text "  controlled, and a bad RF trace passes every automated check." (at 20.32 250.19 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "f3088c79-9b35-44b1-801c-52a924f5d767"))
  (text "PIN MAP (BCM) - mirrors config/meshtasticd/config.yaml exactly:" (at 20.32 261.62 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "e51be9d5-d7aa-44c4-b1b4-17904b6de911"))
  (text "  NSS  GPIO21 (hdr 40)   BUSY GPIO20 (hdr 38)" (at 20.32 266.7 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "1be5e271-24e6-4191-8b64-c6f57822f5a3"))
  (text "  SCK  GPIO11 (hdr 23)   DIO1 GPIO16 (hdr 36)" (at 20.32 273.05 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "1b3abe77-554b-43e4-91c5-5a6a5d008f23"))
  (text "  MOSI GPIO10 (hdr 19)   NRST GPIO18 (hdr 12)" (at 20.32 278.13 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "17b9be33-701e-41b8-884a-bb9992c1dfbb"))
  (text "  MISO GPIO9  (hdr 21)   TXEN GPIO13 (hdr 33)" (at 20.32 284.48 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "08be6d96-8f14-4951-84ca-3ffe968d3b3b"))
  (text "                         RXEN GPIO12 (hdr 32)" (at 20.32 289.56 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "9435beeb-6773-4bab-905d-3fba87087fa6"))
  (text "  Change one, change BOTH files." (at 20.32 294.64 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "408cb991-f37d-4a17-bbd3-aecf0317b9cd"))
  (text "TXEN/RXEN are REQUIRED - the E22 has an RF switch. Leave them" (at 20.32 306.07 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "2b632da1-169d-4bdf-8707-b02b25ee7d38"))
  (text "  unconnected and the PA transmits into a closed switch." (at 20.32 312.42 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "73653089-974d-48a3-83ed-bf87fc049eaa"))
  (text "NEVER power the module without an antenna: 1W into an open" (at 20.32 322.58 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "bbc55a81-5c76-460c-8715-ce4dd17842ad"))
  (text "  circuit damages the PA." (at 20.32 328.93 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "c3a4fb8a-73bd-4a49-bdf9-ed6a73da8180"))
