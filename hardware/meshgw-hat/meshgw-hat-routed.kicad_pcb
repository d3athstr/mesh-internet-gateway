	(footprint "RPi_GPIO40_Horizontal"
		(layer "F.Cu")
		(uuid "7495ab93-783d-42fb-a08d-1de4ce9a5f2f")
		(at 108.37 64.77)
		(descr "Raspberry Pi 40-pin GPIO header, 2x20 2.54mm on 1.5 mm pads (0.25 mm annular ring on a 1.0 mm drill - 1.7 mm pads leave only 0.84 mm between neighbours and the router could not thread the even-row signals out), laid out with the 20 POSITIONS ALONG X (odd pins row y=0, EVEN pins row y=-2.54 - the even row must sit NEARER the board edge, matching the Pi (pins 2/4 = 5V are the outer row). Verified against KiCad's own RaspberryPi-HAT template (J1 pad1 8.37,4.77 / pad2 8.37,2.23 on a 65x56 outline) and the Module.pretty Raspberry_Pi_Zero_Socketed footprint). KiCad's stock PinHeader_2x20 runs its rows along Y; on a HAT the header must run along the 65mm long axis. Generated horizontally so the board needs no rotated footprints - kicad_dsn.py does NOT export footprint rotation to DSN, so a rotated part routes against wrong pad positions.")
		(tags "connector pinheader 2x20 raspberry pi hat")
		(property "Reference" "J1"
			(at -1 3.2 0)
			(layer "F.SilkS")
			(uuid "366628c7-e393-4e39-aefc-aa3eadef557f")
			(effects
