	(footprint "RPi_GPIO40_Horizontal"
		(layer "F.Cu")
		(uuid "a37f3796-5415-469b-9048-5ef16798b57d")
		(at 107 62.5)
		(descr "Raspberry Pi 40-pin GPIO header, 2x20 2.54mm, laid out with the 20 POSITIONS ALONG X (odd pins row y=0, even pins row y=2.54). KiCad's stock PinHeader_2x20 runs its rows along Y; on a HAT the header must run along the 65mm long axis. Generated horizontally so the board needs no rotated footprints - kicad_dsn.py does NOT export footprint rotation to DSN, so a rotated part routes against wrong pad positions.")
		(tags "connector pinheader 2x20 raspberry pi hat")
		(property "Reference" "J1"
